# Token HuggingFace (obligatoire pour le mode "HuggingFace API")
# Creez le votre sur : https://huggingface.co/settings/tokens
# Droits requis : "read" (lecture)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
